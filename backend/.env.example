# ajant backend örnek yapılandırma — TÜM DEĞERLER SAHTE/YER TUTUCUDUR (örnek olarak işaretlidir)
# Kullanım: bu dosyayı `.env` olarak kopyalayın ve SADECE örnek değerleri gerçek değerlerle
# değiştirin. `.env` dosyası .gitignore içindedir ve asla repoya eklenmez (AGENTS.md §3).

# Uygulama
APP_ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ZORUNLU — aşağıdaki değerler ÖRNEKTİR, değiştirin
JWT_SECRET=DEGISTIR-bu-32-karakterden-uzun-sahte-bir-ornek-degerdir-XXX
DATABASE_URL=postgresql+asyncpg://ajant:SAHTE_ORNEK_PAROLA@localhost:5432/ajant

# JWT (Faz 05: panel auth)
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_MINUTES=1440

# Panel auth (Faz 05) — İLK KURULUM: users tablosu boşsa 'admin' kullanıcısı
# BU parolayla oluşturulur. Değer ÖRNEKTİR — değiştirin! Parola ASLA log/panel
# yanıtlarına yansıtılmaz; kullanıcı oluştuktan sonra bu alan yok sayılır.
# Boş bırakılırsa kullanıcı otomatik oluşturulmaz ve panel girişi kapalı kalır.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=DEGISTIR-ilk-kurulum-admin-parolasi-ornek-XXX
# Giriş/refresh uçlarına IP başına dakikalık istek tavanı
AUTH_RATE_LIMIT_PER_MINUTE=10

# Wazuh Indexer (Faz 02) — alert kaynağı; doldurulana kadar devre dışı kalır
# KANIT: Wazuh Server API'de alert OKUMA endpoint'i yoktur; alert'ler Indexer
# API'den (9200) wazuh-alerts-* indeksinden salt okunur okunur.
# Kurulum talimatı (salt okunur servis hesabı): docs/wazuh-staging.md
# Geliştirme demosu için: WAZUH_SOURCE_MODE=mock (gerçek Wazuh gerekmez;
# üretim/prod modunda mock YASAKTIR)
WAZUH_SOURCE_MODE=indexer
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEX_PATTERN=wazuh-alerts-*
WAZUH_VERIFY_TLS=true
WAZUH_TIMEOUT_SECONDS=10
WAZUH_PAGE_SIZE=100
WAZUH_MAX_RETRIES=2
WAZUH_BACKOFF_BASE_SECONDS=0.5
WAZUH_BREAKER_FAILURE_THRESHOLD=5
WAZUH_BREAKER_RESET_SECONDS=30

# Normalizasyon / redaction (Faz 03) — saklanan analiz bağlamı maskeleme politikası
# IP maskeleme modu ürün gereksinimine göre ayarlanır:
#   none     → IP olduğu gibi saklanır (analitik değer tam)
#   masked   → host bitleri sıfırlanır (IPv4 /24, IPv6 /64) — alt ağ korunur (önerilen)
#   redacted → değer tamamen "[ip]" maskesiyle değiştirilir
REDACTION_ENABLED=true
REDACT_IP_MODE=masked
REDACT_EMAIL_MODE=masked
REDACT_SECRET_PATTERNS=true
# Ham alert JSONB saklama (varsayılan KAPALI — gerekçe: docs/phase-03-verification.md).
# Yalnızca izlenebilirlik için ham kopya şartsa açın; depolama ve hassas veri yüzeyi büyür.
STORE_RAW_ALERT=false

# Retention (Faz 03) — events tablosu saklama süresi (gün); varsayılan: 30 gün
RETENTION_DAYS=30

# Ollama (Faz 04) — kullanıcı makinesindeki yerel Ollama; model tag sabittir
# KURULUM: model yüklü değilse backend `/ready` içinde model_missing raporlar.
# Çözüm: `ollama pull qwen3:4b` (q4_K_M quantization varsayılanı Ollama seçer).
# Model API yalnızca iç ağ/localhost üzerinden erişilebilir (aşağıdaki kural).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_TAG=qwen3:4b
# Bilgi amaçlı künye: analiz kayıtlarına yazılır (model_quantization)
OLLAMA_MODEL_QUANTIZATION=Q4_K_M
# Üretim ayarı: düşük sıcaklık + sınırlı çıktı (deterministik, hızlı)
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=512
# Güvenlik kuralı: yalnızca loopback/özel IP/tek-etiket host/host.docker.internal
# kabul edilir. Genel FQDN/IP gerekiyorsa true yapın (olay verisi dışarı çıkabilir).
OLLAMA_ALLOW_PUBLIC_HOST=false

# Analiz worker'ı (Faz 04)
# Kill switch: false iken analiz devre dışı (/ready "disabled")
ANALYSIS_ENABLED=true
# Döngü turunda analiz edilecek en fazla pending event sayısı
ANALYSIS_BATCH_SIZE=10
# Geçersiz çıktı/aktarım hatasında ekstra deneme sayısı (ilk çağrı + max_retries)
ANALYSIS_MAX_RETRIES=1
ANALYSIS_BACKOFF_BASE_SECONDS=1.0
# Prompt'a giden maskeli log tavanı (karakter); aşılırsa kırpılır ve işaretlenir
ANALYSIS_MAX_CONTEXT_CHARS=4000
# Model ham çıktı tavanı (karakter); aşılırsa output_too_long ile reddedilir
ANALYSIS_MAX_OUTPUT_CHARS=6000
# Eşzamanlı analiz sınırı (CPU modunda tek modeli aşırı yüklememek için)
WORKER_CONCURRENCY=2
# Analiz denemesi başına toplam zaman aşımı (saniye)
WORKER_TIMEOUT_SECONDS=120
# Birleşik arka plan döngüsü (fetch → store → analyze): VARSAYILAN KAPALI.
# Açmak için true yapın; tur aralığı WORKER_INTERVAL_SECONDS.
WORKER_LOOP_ENABLED=false
WORKER_INTERVAL_SECONDS=30
# İlk turda geriye doğru taranacak pencere (saniye); sonraki turlarda cursor
# son event zamanından devam eder.
WORKER_INITIAL_WINDOW_SECONDS=900

# Politika (Faz 07'ye kadar observe_only DIŞINA ÇIKMAYIN)
POLICY_MODE=observe_only

# Korelasyon (Faz 06)
# Kill switch: false iken korelasyon döngüsü çalışmaz (tespit yapılmaz)
CORRELATION_ENABLED=true
# Motorun her turda geriye taradığı pencere (saniye; varsayılan 6 saat).
# En uzun kural penceresinden büyük olmalıdır.
CORRELATION_LOOKBACK_SECONDS=21600
# Tek turda taranacak en fazla event sayısı
CORRELATION_MAX_EVENTS_PER_RUN=5000

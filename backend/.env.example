# ajant backend örnek yapılandırma — TÜM DEĞERLER SAHTE/YER TUTUCUDUR (örnek olarak işaretlidir)
# Kullanım: bu dosyayı `.env` olarak kopyalayın ve SADECE örnek değerleri gerçek değerlerle
# değiştirin. `.env` dosyası .gitignore içindedir ve asla repoya eklenmez (AGENTS.md §3).

# Uygulama
APP_ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ZORUNLU — aşağıdaki değerler ÖRNEKTİR, değiştirin
JWT_SECRET=DEGISTIR-bu-32-karakterden-uzun-sahte-bir-ornek-degerdir-XXX
DATABASE_URL=postgresql+asyncpg://ajant:SAHTE_ORNEK_PAROLA@localhost:5432/ajant

# JWT (Faz 05'te kullanılacak)
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_MINUTES=1440

# Wazuh Indexer (Faz 02) — alert kaynağı; doldurulana kadar devre dışı kalır
# KANIT: Wazuh Server API'de alert OKUMA endpoint'i yoktur; alert'ler Indexer
# API'den (9200) wazuh-alerts-* indeksinden salt okunur okunur.
# Kurulum talimatı (salt okunur servis hesabı): docs/wazuh-staging.md
# Geliştirme demosu için: WAZUH_SOURCE_MODE=mock (gerçek Wazuh gerekmez;
# üretim/prod modunda mock YASAKTIR)
WAZUH_SOURCE_MODE=indexer
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEX_PATTERN=wazuh-alerts-*
WAZUH_VERIFY_TLS=true
WAZUH_TIMEOUT_SECONDS=10
WAZUH_PAGE_SIZE=100
WAZUH_MAX_RETRIES=2
WAZUH_BACKOFF_BASE_SECONDS=0.5
WAZUH_BREAKER_FAILURE_THRESHOLD=5
WAZUH_BREAKER_RESET_SECONDS=30

# Ollama (Faz 04) — kullanıcı makinesindeki yerel Ollama; model tag sabittir
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_TAG=qwen3:4b
WORKER_CONCURRENCY=2
WORKER_TIMEOUT_SECONDS=120

# Politika (Faz 07'ye kadar observe_only DIŞINA ÇIKMAYIN)
POLICY_MODE=observe_only
